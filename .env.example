# Discord channel webhook URL. Keep this secret; never commit your real .env.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token

# Optional. Defaults to NationStates' announcements page.
NATIONSTATES_NEWS_URL=https://www.nationstates.net/page=news

# Normal Chrome User-Agent for headless Chromium on a Linux VPS.
NATIONSTATES_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/159.0.0.0 Safari/537.36
